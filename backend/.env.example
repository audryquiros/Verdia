NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=verdia
DB_USER=root
DB_PASSWORD=

# Google Drive / fuente documental
GOOGLE_DRIVE_FOLDER_ID=id-de-la-carpeta-de-google-drive

# Cuenta de servicio de Google Drive.
# Ruta relativa al directorio backend o ruta absoluta.
# Nunca subas el JSON al repositorio.
GOOGLE_APPLICATION_CREDENTIALS=./credenciales/cuenta-servicio.json

# Espacio financiero usado por el script de sincronización local.
RAG_SPACE_ID=1
