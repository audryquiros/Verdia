NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=verdia
DB_USER=root
DB_PASSWORD=

# Google Cloud / Vertex AI RAG Engine
GOOGLE_CLOUD_PROJECT=tu-proyecto-gcp
GOOGLE_CLOUD_LOCATION=us-central1
# Se obtiene después de crear el corpus. Ejemplo:
# projects/123456789/locations/us-central1/ragCorpora/987654321
GOOGLE_CLOUD_RAG_CORPUS=
GOOGLE_CLOUD_DRIVE_FOLDER_ID=id-de-la-carpeta-de-google-drive
GOOGLE_CLOUD_GEMINI_MODEL=gemini-3.5-flash

# Para desarrollo local puedes usar ADC:
# gcloud auth application-default login
# En un servidor, usa una identidad/credencial gestionada y no subas claves al repo.
